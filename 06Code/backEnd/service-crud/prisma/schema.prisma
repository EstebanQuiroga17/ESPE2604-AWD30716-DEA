generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Taxpayer {
  id               String        @id @default(uuid())
  ruc              String        @unique
  email            String        @unique
  password         String?
  birthDate        DateTime?
  role             String        @default("user")
  profileCompleted Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  businessName     String?
  atsFiles         AtsFile[]
  auditEvents      AuditEvent[]
  processSteps     ProcessStep[]
  workspaces       Workspace[]

  @@map("Taxpayer")
}

model Workspace {
  id                  String        @id @default(uuid())
  name                String
  description         String?
  periodMonth         Int?
  periodYear          Int
  periodType          String        @default("monthly")
  periodSemester      Int?
  workspaceLocation   String
  sriConnectionStatus String        @default("disconnected")
  taxpayerId          String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  atsFiles            AtsFile[]
  processSteps        ProcessStep[]
  taxpayer            Taxpayer      @relation(fields: [taxpayerId], references: [id])
}

model AtsFile {
  id               String     @id @default(uuid())
  name             String
  format           String
  periodMonth      Int
  periodYear       Int
  invoiceCount     Int
  validationErrors Int
  taxpayerId       String
  workspaceId      String?
  createdAt        DateTime   @default(now())
  taxpayer         Taxpayer   @relation(fields: [taxpayerId], references: [id])
  workspace        Workspace? @relation(fields: [workspaceId], references: [id])
}

model ProcessStep {
  id          String     @id @default(uuid())
  title       String
  description String
  status      String
  module      String
  completedAt DateTime?
  taxpayerId  String
  workspaceId String?
  createdAt   DateTime   @default(now())
  taxpayer    Taxpayer   @relation(fields: [taxpayerId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
}

model AuditEvent {
  id         String   @id @default(uuid())
  action     String
  module     String
  details    String
  timestamp  DateTime @default(now())
  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])
}
