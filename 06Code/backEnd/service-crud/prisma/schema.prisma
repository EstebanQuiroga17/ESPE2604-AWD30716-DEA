generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Taxpayer {
  id               String        @id @default(uuid())
  ruc              String        @unique
  email            String        @unique
  password         String?
  birthDate        DateTime?
  role             String        @default("user")
  profileCompleted Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  businessName     String?
  workspaces       Workspace[]

  @@map("Taxpayer")
}

model Workspace {
  id                  String        @id @default(uuid())
  name                String
  description         String?
  periodMonth         Int?
  periodYear          Int
  periodType          String        @default("monthly")
  periodSemester      Int?
  taxpayerId          String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  sriConnectionStatus String        @default("disconnected")
  workspaceLocation   String        @default("Local")
  processSteps        ProcessStep[]
  taxpayer            Taxpayer      @relation(fields: [taxpayerId], references: [id])
}

model ProcessStep {
  id          String     @id @default(uuid())
  title       String
  description String
  status      String
  module      String
  completedAt DateTime?
  workspaceId String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
}
